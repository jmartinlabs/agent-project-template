 safety=docs+[root/n for n in ('docs/archive/PROMPT_BACKUP.md','docs/archive/PROMPT_BACKUP_COMPLETE.md','.claude/settings.json','.gitignore','.github/workflows/validate.yml','scripts/validate-template','scripts/test-validator','scripts/work-issue','scripts/test-work-issue','scripts/check-delegation-route','scripts/test-delegation-route','scripts/agent-relay','scripts/test-agent-relay','scripts/review-read') if (root/n).is_file()]
 patterns=(r'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----',r'\bgh[pousr]_[A-Za-z0-9]{30,}\b',r'\bgithub_pat_[A-Za-z0-9_]{30,}\b',r'\bAKIA[A-Z0-9]{16}\b',r'\bsk-[A-Za-z0-9]{32,}\b',r'(?im)^\s*(?:password|api_key|access_token|secret)\s*[:=]\s*["\']?[A-Za-z0-9+/=_-]{20,}')
