#!/usr/bin/env python3
"""Portable structural validation, not a complete security or semantic audit."""
from pathlib import Path
import ast
import json
import re
import sys
from urllib.parse import unquote, urlsplit
SKILLS = ('init-project', 'bootstrap', 'roadmap', 'spec', 'dev', 'orchestrate', 'handoff', 'relay', 'task', 'tweak', 'adopt-project')
REQUIRED = ('AGENTS.md','README.md','NEW_PROJECT_PROMPT.md','ADOPT_EXISTING_PROJECT_PROMPT.md','.gitignore','.github/workflows/validate.yml','specs/README.md',
 *(f'specs/guidelines/{n}.md' for n in ('architecture','ui','quality','security')),
 *(f'templates/{n}.md' for n in ('brainstorming','specification','roadmap','progress','testplan')),
 *(f'.agents/skills/{n}/SKILL.md' for n in SKILLS),'scripts/validate-template','scripts/test-validator','scripts/agent-relay','scripts/test-agent-relay','scripts/check-mermaid.mjs','scripts/report-agent-usage','scripts/test-agent-usage','scripts/auto-agent-usage','scripts/test-auto-agent-usage','.codex/hooks.json','docs/USAGE_REPORTS.md','specs/methodology/workflows.md','specs/methodology/ci-policy.md','specs/methodology/approvals.md','specs/methodology/model-selection.md','specs/methodology/epic-orchestration.md','specs/methodology/dynamic-agents.md','specs/methodology/coordinator-communication.md','templates/epic-board.md','templates/agent-work-packet.md','docs/GUIA_VISUAL_ORQUESTACION.md','docs/CLAUDE_ADAPTER.md','docs/AGENT_EVALS.md','CLAUDE.md','.claude/settings.json','docs/archive/README.md','evals/scenarios.json','evals/sample-responses.json','scripts/eval-agent-behavior',*(f'.claude/skills/{n}/SKILL.md' for n in SKILLS),*(f'.claude/agents/{n}.md' for n in ('functional','implementation','qa-review','infrastructure')),*(f'.agents/roles/{n}.md' for n in ('README','functional','implementation','qa-review','infrastructure')))
EXPECTED_GIT={
 'status':({},()),
 'branches':({},()),
 'log':({'max':'int','path':'path','rev':'rev'},()),
 'show':({'rev':'rev','path':'path','stat':'flag'},('rev',)),
 'diff':({'base':'rev','head':'rev','path':'path','stat':'flag'},()),
 'file-history':({'max':'int','path':'path'},('path',)),
 'changed-files':({'base':'rev','head':'rev'},('base','head')),
 'search':({'pattern':'text','path':'path'},('pattern',)),
}
EXPECTED_GITHUB={
 'pr':({'number':'int'},('number',)),
 'pr-diff':({'number':'int','name-only':'flag','patch':'flag'},('number',)),
 'pr-checks':({'number':'int'},('number',)),
 'pr-list':({'limit':'int'},()),
 'run':({'run-id':'run_id'},('run-id',)),
 'run-list':({'limit':'int','branch':'ref'},()),
}
EXPECTED_FILE={
 'read':({'path':'path'},('path',)),
}
def wildcard(pattern,value):
 return re.fullmatch(''.join('.*' if c=='*' else '.' if c=='?' else re.escape(c) for c in pattern),value,re.S) is not None
def effective(rules,action,resource):
 result='ask'
 for rule_action,rule_resource,rule_effect in rules:
  if wildcard(rule_action,action) and wildcard(rule_resource,resource): result=rule_effect
 return result
def parse_opencode_permissions(text):
 match=re.match(r'\A---\r?\n(.*?)\r?\n---\r?\n',text,re.S)
 if not match: return None,['missing YAML frontmatter']
 keys={}; rules=[]; current=None; mode=None; errors=[]
 def scalar(value):
  value=value.strip()
  return value[1:-1] if len(value)>=2 and value[0]==value[-1] and value[0] in '"\'' else value
 for line in match[1].splitlines():
  if not line.strip() or line.lstrip().startswith('#'): continue
  top=re.match(r'^([A-Za-z_][A-Za-z0-9_-]*):(?:\s*(.*))?$',line)
  if top:
   key,value=top[1],(top[2] or '').strip()
   if key in keys: errors.append(f'duplicate frontmatter key: {key}')
   keys[key]=value; mode=key; current=None
   if key=='permissions' and value: errors.append('permissions must be a block list')
   continue
  if mode!='permissions':
   errors.append(f'unexpected frontmatter line: {line.strip()}')
   continue
  item=re.match(r'^\s*-\s+([A-Za-z_]+):\s*(.*)$',line)
  if item:
   current={item[1]:scalar(item[2])}; rules.append(current); continue
  field=re.match(r'^\s+([A-Za-z_]+):\s*(.*)$',line)
  if field and current is not None and field[1] not in current:
   current[field[1]]=scalar(field[2]); continue
  errors.append(f'unexpected permission line: {line.strip()}')
 allowed_fields={'description','mode','permissions','color'}
 if set(keys)-allowed_fields: errors.append('unexpected frontmatter fields: '+', '.join(sorted(set(keys)-allowed_fields)))
 if 'color' in keys and not re.fullmatch(r'"#[0-9A-Fa-f]{6}"', keys['color']):
  errors.append('color must be a quoted six-digit hex value')
 for index,rule in enumerate(rules,1):
  if set(rule)!={'action','resource','effect'}: errors.append(f'permission rule {index} must contain only action, resource and effect')
  if rule.get('effect') not in ('allow','ask','deny'): errors.append(f'permission rule {index} has invalid effect')
 return [tuple(rule.get(key,'') for key in ('action','resource','effect')) for rule in rules],errors
def review_read_policy(root):
 path=root/'scripts/review-read'
 try: source=path.read_text(encoding='utf-8'); tree=ast.parse(source)
 except (OSError,UnicodeError,SyntaxError) as error: return None,f'cannot parse review-read: {error}'
 if 'shell=False' not in source or 'shell=True' in source: return None,'review-read must execute without a shell'
 for token in ('PROTECTED_FILES','PROTECTED_DIRS','build_excludes','EXCLUDES = build_excludes()','.npmrc','.netrc','.pypirc','.git-credentials','*.kdbx','*.jks','*.keystore','id_dsa','*.pem','*credentials.json','*.credentials','*.secret','*.secrets','.envrc','*.env.example','*secret*','*credential*','parse_name_status_z','changed_files_text','file_history_text','filter_status','rename_excludes_from','file_operation'):
  if token not in source: return None,f'review-read protection list missing {token}'
 policy=None
 for node in tree.body:
  if isinstance(node,ast.Assign) and any(isinstance(target,ast.Name) and target.id=='POLICY' for target in node.targets):
   try: policy=ast.literal_eval(node.value)
   except (ValueError,TypeError): return None,'POLICY must be a literal'
 if policy is None: return None,'missing POLICY literal'
 if not isinstance(policy,dict) or set(policy)!={'version','max_output_bytes','git','github','file'}: return None,'unexpected POLICY shape'
 if policy.get('version')!=1: return None,'POLICY version must be 1'
 limit=policy.get('max_output_bytes')
 if not isinstance(limit,int) or not 1000<=limit<=200000: return None,'max_output_bytes must be 1000..200000'
 for group,expected in (('git',EXPECTED_GIT),('github',EXPECTED_GITHUB),('file',EXPECTED_FILE)):
  value=policy.get(group)
  if not isinstance(value,dict) or set(value)!={'operations'} or not isinstance(value.get('operations'),dict):
   return None,f'{group} policy must contain only operations'
  if set(value['operations'])!=set(expected): return None,f'{group} operation allowlist changed'
  for name,(options,required) in expected.items():
   spec=value['operations'][name]
   if not isinstance(spec,dict) or set(spec)-{'options','required'} or spec.get('options')!=options or tuple(spec.get('required',()))!=required:
    return None,f'{name} options or requirements changed'
 return policy,None

def validate(root):
 root=Path(root).resolve(); errors=[]
 def fail(rule,msg): errors.append(f'{rule}: {msg}')
 def read(name):
  p=root/name
  return p.read_text(encoding='utf-8') if p.is_file() else ''
 for name in REQUIRED:
  if not (root/name).is_file() or not (root/name).stat().st_size: fail('structure',f'missing or empty {name}')
 opencode_agent=root/'.opencode/agents/review.md'
 opencode_plugin_dir=root/'.opencode/plugins/review-read'
 opencode_plugin=opencode_plugin_dir/'index.ts'
 opencode_wrapper=root/'scripts/review-read'
 opencode_components=(opencode_agent,opencode_plugin_dir,opencode_wrapper)
 opencode_present=[p for p in opencode_components if p.exists()]
 opencode_installed=all(p.is_file() for p in (opencode_agent,opencode_plugin,opencode_wrapper))
 if opencode_present and not opencode_installed:
  missing=[str(p.relative_to(root)) for p in (opencode_agent,opencode_plugin,opencode_wrapper) if not p.is_file()]
  fail('opencode','incomplete review adapter; missing '+', '.join(missing))
 optional_opencode_doc=(root/'docs/OPENCODE_ADAPTER.md').resolve()
 docs=[root/n for n in ('AGENTS.md','README.md','NEW_PROJECT_PROMPT.md','ADOPT_EXISTING_PROJECT_PROMPT.md','docs/OPENCODE_ADAPTER.md') if (root/n).is_file()]
 for folder in ('specs','templates','.agents/skills','.claude/skills','.claude/agents'):
  docs.extend((root/folder).rglob('*.md'))
 for p in docs:
  s=p.read_text(encoding='utf-8')
  for dest in re.findall(r'(?<!!)\[[^\]\n]+\]\(([^)\n]+)\)',s):
   dest=dest.strip().split(' "',1)[0].strip('<>'); u=urlsplit(dest)
   if u.scheme or dest.startswith('#'): continue
   target=(p.parent/unquote(u.path)).resolve()
   if not opencode_installed and target==optional_opencode_doc: continue
   if not target.is_relative_to(root) or not target.exists(): fail('links',f'{p.relative_to(root)} -> {dest}')
 agents=read('AGENTS.md')
 for n in ('architecture','ui','quality','security'):
  if f'(specs/guidelines/{n}.md)' not in agents: fail('agents',f'missing guideline {n}')
 if len(agents.splitlines())>65: fail('agents','AGENTS.md exceeds 65 lines')
 for name in SKILLS:
  s=read(f'.agents/skills/{name}/SKILL.md')
  m=re.match(r'\A---\nname: ([a-z0-9-]+)\ndescription: ([^\n]+)\n---\n',s)
  if not m or m[1]!=name or not 1<=len(m[2])<=1024: fail('manifest',f'{name}: invalid name/description')
  elif any(c in m[2] for c in (': ',' #','{','}','[',']')): fail('manifest',f'{name}: use plain scalar description')
  for h in ('## Inputs','## Outputs','## Procedure','## Stop conditions'):
   if h not in s: fail('contracts',f'{name}: missing {h}')
 # Claude adapters are wrappers, never copies that silently drift from canonical Skills.
 claude=read('CLAUDE.md')
 if '@AGENTS.md' not in claude: fail('claude','CLAUDE.md must load canonical AGENTS.md')
 for name in SKILLS:
  s=read(f'.claude/skills/{name}/SKILL.md')
  if f'.agents/skills/{name}/SKILL.md' not in s or f'name: {name}' not in s:
   fail('claude',f'{name}: missing canonical Skill reference or manifest name')
 for name in ('functional','implementation','qa-review','infrastructure'):
  s=read(f'.claude/agents/{name}.md')
  if f'.agents/roles/{name}.md' not in s or f'name: {name}' not in s:
   fail('claude',f'{name}: missing canonical role reference or manifest name')
  if 'Applicable rules' not in s: fail('claude',f'{name}: profile must rely on the packet Applicable rules')
 # OpenCode's native review adapter is optional. When installed it must be complete and
 # read-only; when intentionally absent, derived projects keep passing general validation.
 opencode_path=root/'.opencode/agents/review.md'
 if opencode_installed and opencode_path.stat().st_size:
  opencode=opencode_path.read_text(encoding='utf-8')
  for token in ('mode: subagent','.agents/roles/qa-review.md','work packet','Applicable rules','read-only','BLOCKED','UNRUN','scripts/review-read','review_query'):
   if token not in opencode: fail('opencode',f'review adapter missing {token}')
  if not re.search(r'(?m)^mode: subagent$',opencode): fail('opencode','review adapter mode must be exactly subagent')
  if not re.search(r'(?m)^description: \S',opencode): fail('opencode','review adapter needs a description')
  entries,parse_errors=parse_opencode_permissions(opencode)
  for message in parse_errors: fail('opencode',message)
  if entries is not None:
   if not entries or entries[0] != ('*','*','deny'): fail('opencode','review adapter must start with a deny-all rule')
   if effective(entries,'read','AGENTS.md')!='deny' or effective(entries,'read','src/main.py')!='deny': fail('opencode','review adapter must deny the native read tool')
   if effective(entries,'glob','**/*.py')!='allow': fail('opencode','review adapter must allow glob discovery')
   for path in ('.env','config/.env','.env.local','.ssh/.env.example','secrets/id_rsa','id_dsa','.git/config','vendor/.git/config','credentials.json','app.pem','.npmrc','.netrc','.pypirc','.git-credentials','vault.kdbx','app.jks','app.keystore','service.credentials','service.secret','service.secrets','secrets.yaml','config/credentials.yml','src/.envrc','.NPMRC','SERVICE.KDBX','Secrets.yaml', '.eNv','foo.env.example','prod.env.example','config/foo.env.example','secrets/api-key.txt','credentials/config.yaml','secret.env.example','credential.env.example','config/secret.env.example'):
    if effective(entries,'read',path)!='deny': fail('opencode',f'review adapter must deny protected read: {path}')
   if effective(entries,'read','.env.example')!='deny': fail('opencode','review adapter must deny native read even for .env.example; use review_query file read')
   if effective(entries,'read','config/.env.example')!='deny': fail('opencode','review adapter must deny native read for nested .env.example')
   for action in ('edit','subagent','skill','webfetch','websearch','question','execute','external_directory','browser','shell'):
    if effective(entries,action,'*')!='deny': fail('opencode',f'review adapter must deny {action}')
   if effective(entries,'review_query','*')!='allow': fail('opencode','review adapter must allow the read-only query tool')
   for action,resource,effect in entries:
    if effect in ('allow','ask'):
     if action not in ('glob','review_query'): fail('opencode',f'non-read-only permission {effect}: {action}')
     if action=='review_query' and (resource!='*' or effect!='allow'): fail('opencode','review tool permission must be a single allow for the query tool')
   if sum(1 for action,resource,effect in entries if action=='review_query' and effect=='allow')!=1: fail('opencode','exactly one review_query allow rule is required')
   if any(action=='read' and effect!='deny' for action,resource,effect in entries): fail('opencode','native read rules must deny access')
   if any(action=='glob' and effect=='allow' and resource!='*' for action,resource,effect in entries): fail('opencode','glob allow must cover the workspace')
  for helper in ('scripts/review-read','.opencode/plugins/review-read/index.ts'):
   helper_path=root/helper
   if not helper_path.is_file() or not helper_path.stat().st_size: fail('opencode',f'adapter requires {helper}')
  plugin=read('.opencode/plugins/review-read/index.ts')
  for token in ('namespace({','name: "review"','name: "query"','codemode: false','["git", "github", "file", "describe"]','scripts/review-read','shell: false','spawn("python3"','Number.isSafeInteger','exit 2\\nINVALID:'):
   if token not in plugin: fail('opencode',f'review query plugin missing {token}')
  if plugin.count('editor.add(')!=1: fail('opencode','review query plugin must register exactly one tool')
  if re.search(r'\b(?:exec|execSync|spawnSync|eval|Function|fetch)\s*\(',plugin): fail('opencode','review query plugin must not execute arbitrary code or fetch')
  if 'shell: true' in plugin: fail('opencode','review query plugin must not enable a shell')
  policy,policy_error=review_read_policy(root)
  if policy_error: fail('opencode',policy_error)
 elif opencode_path.exists():
  fail('opencode','review adapter is empty')
 # The specialized agents are optional independently and use OpenCode's default
 # subagent capabilities. Their role and work packet are behavioral contracts.
 specialized_present=[]
 for name in ('functional','implementation','infrastructure'):
  native_path=root/f'.opencode/agents/{name}.md'
  if not native_path.exists():
   continue
  specialized_present.append(name)
  if not native_path.stat().st_size:
   fail('opencode',f'{name} adapter is empty')
   continue
  native=native_path.read_text(encoding='utf-8')
  for token in ('mode: subagent',f'.agents/roles/{name}.md','Required packet','## Return'):
   if token not in native: fail('opencode',f'{name} adapter missing {token}')
  if not re.search(r'(?m)^mode: subagent$',native): fail('opencode',f'{name} mode must be exactly subagent')
  if not re.search(r'(?m)^description: \S',native): fail('opencode',f'{name} adapter needs a description')
  if re.search(r'(?m)^model:',native): fail('opencode',f'{name} adapter must inherit the coordinator model')
  entries,parse_errors=parse_opencode_permissions(native)
  for message in parse_errors: fail('opencode',f'{name}: {message}')
  if entries: fail('opencode',f'{name} adapter must use OpenCode default permissions')
 if opencode_installed:
  opencode_doc=read('docs/OPENCODE_ADAPTER.md')
  for token in ('.opencode/agents/review.md','.agents/roles/qa-review.md','read-only','not a launcher','scripts/review-read','review_query','optional','BLOCKED','UNRUN'):
   if token not in opencode_doc: fail('opencode',f'documentation missing {token}')
 if specialized_present:
  opencode_doc=read('docs/OPENCODE_ADAPTER.md')
  for name in specialized_present:
   for token in (f'.opencode/agents/{name}.md',f'.agents/roles/{name}.md','OpenCode default'):
    if token not in opencode_doc: fail('opencode',f'documentation missing {name} token {token}')
 # Approval wording lives in approvals.md; adapters link to it instead of restating it.
 for name in ('CLAUDE.md',*(f'.claude/skills/{n}/SKILL.md' for n in SKILLS)):
  if re.search(r'`(?:ok|dale|continúa)`',read(name)): fail('claude',f'{name}: restates approval wording; link approvals.md instead')
 for filename, key in [('evals/scenarios.json','cases'),('evals/sample-responses.json','responses')]:
  try:
   payload=json.loads(read(filename))
   if payload.get('version')!='1.0' or not isinstance(payload.get(key),list) or len(payload[key])<10:
    fail('agent-evals',f'{filename}: invalid or incomplete evaluation fixture')
  except (ValueError,AttributeError,TypeError):
   fail('agent-evals',f'{filename}: invalid JSON')
 handoff=read('.agents/skills/handoff/SKILL.md').lower()
 for token in ('stop issuing new development', 'not controlled', 'unconfirmed', 'no auto-resume', 'git status', 'pass/fail/unrun', 'next session', 'quota exhaustion', 'never merge'):
  if token not in handoff: fail('handoff',f'handoff missing {token}')
 if 'eval-agent-behavior' not in read('.github/workflows/validate.yml'):
  fail('agent-evals','CI must run agent eval scorer self-test')
 workflows=read('specs/methodology/workflows.md')
 for token in ('Quick', 'Standard', 'Full', 'confirm', 'Brainstorming', 'Walking skeleton'):
  if token.lower() not in workflows.lower(): fail('orchestration',f'workflow missing {token}')
 model_selection=read('specs/methodology/model-selection.md')
 for token in ('efficient', 'balanced', 'advanced', 'reasoning', 'availability', 'user', 'verification'):
  if token.lower() not in model_selection.lower(): fail('model-selection',f'model policy missing {token}')
 orchestrator=read('.agents/skills/orchestrate/SKILL.md')
 if 'specs/methodology/model-selection.md' not in orchestrator: fail('model-selection','orchestrator is not wired to the model policy')
 for token in ('one executor', 'checkpoint', 'independent qa', 'two comparable'):
  if token not in orchestrator.lower(): fail('orchestration-efficiency',f'orchestrator missing {token}')
 if '(specs/methodology/model-selection.md)' not in agents: fail('model-selection','AGENTS.md missing model policy link')
 epic=read('specs/methodology/epic-orchestration.md')
 for token in ('single writer', 'awaiting-approval', 'hard dependencies', 'approved', 'independent', 'merge', 'active'):
  if token.lower() not in epic.lower(): fail('epic-scheduling',f'epic contract missing {token}')
 board=read('templates/epic-board.md')
 for token in ('Hard dependencies', 'Spec status', 'Dev status', 'QA status', 'Next independent action', 'Last reconciled'):
  if token.lower() not in board.lower(): fail('epic-scheduling',f'board missing {token}')
 if 'specs/methodology/epic-orchestration.md' not in orchestrator: fail('epic-scheduling','coordinator not linked to epic scheduling')
 if '(specs/methodology/epic-orchestration.md)' not in agents: fail('epic-scheduling','AGENTS.md missing epic scheduling link')
 for role, tokens in {'functional':('approval','brainstorming'),'implementation':('approved','dependencies'),'qa-review':('independent','pass/fail')}.items():
  text=read(f'.agents/roles/{role}.md').lower()
  for token in tokens:
   if token not in text: fail('epic-scheduling',f'role {role} missing {token}')
 dynamic=read('specs/methodology/dynamic-agents.md')
 for token in ('profiles', 'one executor', 'parallel', 'quota', 'supported', 'sequential', 'financial', 'close', 'work-packet', 'independent qa', 'applicable rules'):
  if token.lower() not in dynamic.lower(): fail('dynamic-agents',f'dynamic policy missing {token}')
 if 'specs/methodology/dynamic-agents.md' not in orchestrator: fail('dynamic-agents','orchestrator not wired to dynamic management')
 if '(specs/methodology/dynamic-agents.md)' not in agents: fail('dynamic-agents','AGENTS.md missing dynamic management link')
 if '(dynamic-agents.md)' not in workflows: fail('dynamic-agents','workflows missing dynamic management link')
 if '(infrastructure.md)' not in read('.agents/roles/README.md'): fail('dynamic-agents','infrastructure specialist not linked')
 # Execution mode is adaptive: direct, foreground or background only with verified support.
 for token in ('## Execution mode: direct, foreground, background','**Direct (coordinator).**','**Foreground subagent.**','**Background subagent.**','verified client support',"Releasing the coordinator's turn",'Promise no background persistence','who executes','mode (direct, foreground or background)','coordinator stays available','Never claim a subagent','No universal agent count'):
  if token not in dynamic: fail('execution-mode',f'dynamic policy missing {token}')
 for token in ('execution mode adaptively','background only with verified client support','coordinator availability','background persistence'):
  if token not in orchestrator: fail('execution-mode',f'orchestrator missing {token}')
 packet=read('templates/agent-work-packet.md')
 for token in ('Packet ID', 'Spec approval', 'Write files', 'Hard dependencies', 'Applicable rules', 'Verification', 'Return schema', 'Never ask the user directly from a subagent'):
  if token.lower() not in packet.lower(): fail('dynamic-agents',f'agent work packet missing {token}')
 guide=read('docs/GUIA_VISUAL_ORQUESTACION.md')
 diagrams=re.findall(r'(?ms)^\x60{3}mermaid\r?\n(.*?)^\x60{3}[ \t]*$',guide)
 if len(diagrams)<6: fail('visual-guide','need at least six Mermaid diagrams')
 for i,diagram in enumerate(diagrams,1):
  if not re.match(r'(flowchart|stateDiagram|sequenceDiagram|graph)\b',diagram.strip()): fail('visual-guide',f'diagram {i} has unsupported header')
 for token in ('MyFinanzas', 'aprobación', 'Infraestructura', 'subagentes', 'migrar', 'Git', 'checkpoint'):
  if token.casefold() not in guide.casefold(): fail('visual-guide',f'visual guide missing {token}')
 s=read('.agents/skills/init-project/SKILL.md')
 for token in ('specs/setup-progress.md','### Resume protocol','## Pending decisions','## Confirmed decisions','## Next action','awaiting-approval',*(f'### Stage {i} —' for i in range(1,8))):
  if token not in s: fail('resume',f'init-project missing {token}')
 s=read('NEW_PROJECT_PROMPT.md'); m=re.search(r'```text\n(.*?)\n```',s,re.S)
 tokens=('[PROJECT_NAME]','[SHORT_DESCRIPTION]','https://github.com/','independent','AGENTS.md','$init-project','specs/setup-progress.md','owner','visibility','authorization','planning','$spec','$dev')
 if not m or any(t.lower() not in m[1].lower() for t in tokens): fail('prompt','incomplete copyable prompt')
 adoption=read('ADOPT_EXISTING_PROJECT_PROMPT.md'); block=re.search(r'```text\n(.*?)\n```',adoption,re.S)
 required_adoption=('github.com/jmartinlabs/agent-project-template','adopt-project/SKILL.md','before modifying','approval','existing','do not','orchestrate')
 if not block or any(x.lower() not in block[1].lower() for x in required_adoption): fail('adopt-prompt','existing-project prompt incomplete')
 if block:
  sources=re.findall(r'raw\.githubusercontent\.com/jmartinlabs/agent-project-template/([^/\s]+)/',block[1])
  pinned=re.search(r'(?im)^Pinned revision: ([0-9a-f]{40})$',block[1])
  if not sources or not pinned or any(ref!=pinned[1] for ref in sources): fail('adopt-prompt','remote Skill source must use the pinned full commit SHA, never a branch')
  for x in ('untrusted','explicit confirmation'):
   if x not in block[1].lower(): fail('adopt-prompt',f'remote Skill must be reviewed as data: missing {x}')
 # Ask-before-run prompts are defense in depth; deny rules would block approved actions.
 try:
  settings=json.loads(read('.claude/settings.json'))
  ask=settings.get('permissions',{}).get('ask',[])
  for x in ('Bash(gh pr merge *)','Bash(git push --force*)'):
