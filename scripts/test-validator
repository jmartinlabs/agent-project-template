 def test_product_document_policy_regressions(self):
  # Structural preservation guards; generated harnesses test real Git behavior.
  mutations = (
   ('families', 'brainstorming|specification|progress|testplan'),
   ('protected precedence', 'Protected exclusions take precedence'),
   ('policy changes', 'Changes to the allowlist or classifier themselves require `full`'),
   ('add modify delete', 'additions, modifications and deletions'),
   ('rename endpoints', 'both rename directions checked'),
   ('mixed protected files', 'alone and mixed with allowed product documentation'),
   ('adaptable paths', 'valid alternate product paths'),
   ('existing project', 'without init-project'),
  )
  p=self.root/'specs/methodology/ci-policy.md'; original=p.read_text()
  for case, token in mutations:
   with self.subTest(case=case):
    self.assertIn(token, original)
    try:
     p.write_text(original.replace(token, 'REMOVED'))
     self.assertRule('ci-policy')
    finally:
     p.write_text(original)
