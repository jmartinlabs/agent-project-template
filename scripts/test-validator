 def test_publication_policy_contract(self):
  cases = (
   '## Branch and PR publication', 'No separate publication approval is needed',
   'local only', 'draft PR', 'Before pushing, review the diff',
   'An open PR does', 'Creating or merging a specification PR neither approves its content',
