 def test_ci_policy_contract(self):
  for token in ('explicitly allowlisted', 'classification errors default to `full`',
                'Documentation and security controls are mandatory',
                'structure and execution conditions', 'unexpected skipped checks',
                'continue-on-error', 'Preserve approved security controls'):
   with self.subTest(token=token):
    p=self.root/'specs/methodology/ci-policy.md'; original=p.read_text()
    p.write_text(original.replace(token, 'REMOVED'))
    self.assertRule('ci-policy'); p.write_text(original)
