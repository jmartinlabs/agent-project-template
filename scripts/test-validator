class FixtureIsolationTests(unittest.TestCase):
 def setUp(self):
  temp=tempfile.TemporaryDirectory(); self.addCleanup(temp.cleanup)
  self.tmp=Path(temp.name)
 def git(self,root,*args):
  subprocess.run(['git','-c','user.name=Test','-c','user.email=test@example.invalid','-C',str(root),*args],check=True,capture_output=True)
 def repository(self,name='source'):
  root=self.tmp/name; root.mkdir(); self.git(root,'init','-q'); return root
 def commit(self,root):
  self.git(root,'add','-A'); self.git(root,'commit','-q','-m','initial')
 def test_untracked_file_excluded(self):
  source=self.repository(); (source/'README.md').write_text('# tracked\n'); self.commit(source)
  (source/'specs').mkdir(); (source/'specs/local.md').write_text(MACHINE_PATH+'\n')
  fixture=build_fixture(source,self.tmp/'fixture')
  self.assertFalse((fixture/'specs/local.md').exists())
  self.assertFalse(any(e.startswith('portability:') for e in validate(fixture)))
 def test_uncommitted_change_preserved(self):
  source=self.repository(); (source/'README.md').write_text('HEAD content\n'); self.commit(source)
  (source/'README.md').write_text('working content\n')
  fixture=build_fixture(source,self.tmp/'fixture')
  self.assertEqual((fixture/'README.md').read_text(),'working content\n')
 def test_missing_tracked_file_fails(self):
  source=self.repository(); (source/'README.md').write_text('# x\n'); (source/'gone.md').write_text('# gone\n'); self.commit(source)
  (source/'gone.md').unlink()
  with self.assertRaises(RuntimeError) as caught: build_fixture(source,self.tmp/'fixture')
  self.assertIn('gone.md',str(caught.exception))
 def test_without_git_copies_tree_and_reports_limitation(self):
  source=self.tmp/'export'; (source/'__pycache__').mkdir(parents=True); (source/'artifacts').mkdir()
  (source/'keep.md').write_text('# keep\n'); (source/'__pycache__/x.pyc').write_text('x'); (source/'artifacts/log').write_text('x')
  out=io.StringIO()
  with contextlib.redirect_stdout(out): fixture=build_fixture(source,self.tmp/'fixture')
  self.assertEqual(out.getvalue(),NO_GIT_NOTICE+'\n')
  self.assertTrue((fixture/'keep.md').is_file()); self.assertFalse((fixture/'__pycache__').exists()); self.assertFalse((fixture/'artifacts').exists())
 def test_tracked_machine_path_still_fails_portability(self):
  source=self.repository(); (source/'README.md').write_text(MACHINE_PATH+'\n'); self.commit(source)
  fixture=build_fixture(source,self.tmp/'fixture')
  self.assertTrue((fixture/'README.md').is_file())
  self.assertTrue(any(e.startswith('portability:') for e in validate(fixture)))
 def test_git_unavailable_does_not_fallback(self):
  source=self.repository(); (source/'README.md').write_text('# x\n'); self.commit(source)
  (source/'local.md').write_text(MACHINE_PATH+'\n'); (self.tmp/'empty-bin').mkdir()
  path=os.environ.get('PATH'); os.environ['PATH']=str(self.tmp/'empty-bin')
  out=io.StringIO()
  try:
   with contextlib.redirect_stdout(out), self.assertRaises(RuntimeError) as caught: build_fixture(source,self.tmp/'fixture')
  finally:
   if path is None: os.environ.pop('PATH',None)
   else: os.environ['PATH']=path
  self.assertIn('git is unavailable',str(caught.exception)); self.assertNotIn(NO_GIT_NOTICE,out.getvalue()); self.assertFalse((self.tmp/'fixture').exists())
 def test_worktree_git_file_copies_tracked_content(self):
  source=self.repository(); (source/'README.md').write_text('HEAD content\n'); self.commit(source)
  linked=self.tmp/'linked'; self.git(source,'worktree','add','-q','-b','linked-branch',str(linked))
  (linked/'README.md').write_text('working content\n')
  self.assertTrue((linked/'.git').is_file())
  out=io.StringIO()
  with contextlib.redirect_stdout(out): fixture=build_fixture(linked,self.tmp/'fixture')
  self.assertNotIn(NO_GIT_NOTICE,out.getvalue())
  self.assertEqual((fixture/'README.md').read_text(),'working content\n')
 def test_ls_files_failure_does_not_fallback(self):
  source=self.tmp/'broken'; source.mkdir(); (source/'.git').write_text('not a gitdir\n')
  (source/'local.md').write_text(MACHINE_PATH+'\n')
  out=io.StringIO()
  with contextlib.redirect_stdout(out), self.assertRaises(RuntimeError) as caught: build_fixture(source,self.tmp/'fixture')
  self.assertIn('git ls-files failed',str(caught.exception))
  self.assertNotIn(NO_GIT_NOTICE,out.getvalue()); self.assertFalse((self.tmp/'fixture').exists())
if __name__=='__main__': unittest.main(verbosity=2)
