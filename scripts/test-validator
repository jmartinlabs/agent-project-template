#!/usr/bin/env python3
"""Positive and isolated negative fixtures for every validation category."""
from pathlib import Path
import contextlib
import io
import json
import os
import re
import runpy
import shutil
import subprocess
import sys
import tempfile
import unittest
ROOT=Path(__file__).resolve().parents[1]
validate=runpy.run_path(str(ROOT/'scripts/validate-template'))['validate']
NO_GIT_NOTICE='NOTICE: fixture built without Git metadata; untracked-file isolation is not enforced.'
# Concatenated so this file does not trip the portability rule it exercises.
MACHINE_PATH='/'+'Users/algo'
def build_fixture(source_root,dest_root):
 # Isolate fixtures from untracked local files (handoffs, caches): with Git metadata,
 # copy only the tracked working-tree content, never the whole directory.
 source_root=Path(source_root); dest_root=Path(dest_root)
 if (source_root/'.git').exists():
  try:
   listed=subprocess.run(['git','-C',str(source_root),'ls-files','-z','--cached'],capture_output=True,check=True)
  except FileNotFoundError as exc:
   raise RuntimeError(f'Git metadata present in {source_root} but git is unavailable') from exc
  except OSError as exc:
   raise RuntimeError(f'cannot run git ls-files in {source_root}: {exc}') from exc
  except subprocess.CalledProcessError as exc:
   detail=exc.stderr.decode('utf-8','replace').strip()
   raise RuntimeError(f'git ls-files failed in {source_root}: {detail or exc}') from exc
  dest_root.mkdir(parents=True,exist_ok=True)
  for rel in listed.stdout.decode('utf-8','surrogateescape').split('\0'):
   if not rel: continue
   src=source_root/rel
   if not src.is_file(): raise RuntimeError(f'tracked file missing from working tree: {rel}')
   dst=dest_root/rel; dst.parent.mkdir(parents=True,exist_ok=True); shutil.copy2(src,dst)
 else:
  shutil.copytree(source_root,dest_root,ignore=shutil.ignore_patterns('.git','__pycache__','artifacts'))
  print(NO_GIT_NOTICE)
 return dest_root
class ValidationTests(unittest.TestCase):
 def setUp(self):
  temp=tempfile.TemporaryDirectory(); self.addCleanup(temp.cleanup)
  self.root=Path(temp.name)/'fixture'
  build_fixture(ROOT,self.root)
 def change(self,name,old,new):
  p=self.root/name; p.write_text(p.read_text().replace(old,new))
