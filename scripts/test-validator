 def test_ci(self):
  self.change('.github/workflows/validate.yml','./scripts/test-validator','echo skip'); self.assertRule('ci')
 def test_ci_whitespace_net_delta(self):
  self.mutate_workflow(lambda w: w['jobs']['required']['steps'][-1].update({'run':'git diff --check'}))
 def mutate_workflow(self, mutation):
  p=self.root/'.github/workflows/validate.yml'; data=json.loads(p.read_text())
  mutation(data); p.write_text(json.dumps(data)); self.assertRule('ci')
 def test_ci_whitespace_full_history(self):
  self.mutate_workflow(lambda w: w['jobs']['required']['steps'][0]['with'].update({'fetch-depth':1}))
 def test_ci_whitespace_push_base(self):
  self.mutate_workflow(lambda w: w['jobs']['required']['steps'][-1]['env'].update({'BASE_SHA':'${{ github.event.pull_request.base.sha }}'}))
 def test_ci_working_branch_push_rejected(self):
