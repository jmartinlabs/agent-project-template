#!/usr/bin/env python3
"""Positive and isolated negative fixtures for every validation category."""
from pathlib import Path
import re
import runpy
import shutil
import subprocess
import sys
import tempfile
import unittest
ROOT=Path(__file__).resolve().parents[1]
validate=runpy.run_path(str(ROOT/'scripts/validate-template'))['validate']
class ValidationTests(unittest.TestCase):
 def setUp(self):
  temp=tempfile.TemporaryDirectory(); self.addCleanup(temp.cleanup)
  self.root=Path(temp.name)/'fixture'
  shutil.copytree(ROOT,self.root,ignore=shutil.ignore_patterns('.git','__pycache__','artifacts'))
 def change(self,name,old,new):
  p=self.root/name; p.write_text(p.read_text().replace(old,new))
 def assertRule(self,rule): self.assertTrue(any(e.startswith(rule+':') for e in validate(self.root)),rule)
 def test_valid(self): self.assertEqual(validate(self.root),[])
 def test_claude_adapter_required(self):
  (self.root/'.claude/skills/orchestrate/SKILL.md').unlink(); self.assertRule('structure')
 def test_claude_canonical_bridge(self):
  self.change('CLAUDE.md','@AGENTS.md','@README.md'); self.assertRule('claude')
 def test_claude_skill_canonical_path(self):
  self.change('.claude/skills/orchestrate/SKILL.md','.agents/skills/orchestrate/SKILL.md','README.md'); self.assertRule('claude')
 def test_agent_eval_fixtures_required(self):
  (self.root/'evals/scenarios.json').unlink(); self.assertRule('structure')
 def test_agent_eval_ci_wiring(self):
  self.change('.github/workflows/validate.yml','scripts/eval-agent-behavior','scripts/skip-agent-evals'); self.assertRule('agent-evals')
 def test_structure(self):
  (self.root/'templates/progress.md').unlink(); self.assertRule('structure')
 def test_orchestrator_structure(self):
  (self.root/'.agents/skills/orchestrate/SKILL.md').unlink(); self.assertRule('structure')
 def test_handoff_skill_required(self):
  (self.root/'.agents/skills/handoff/SKILL.md').unlink(); self.assertRule('structure')
 def test_handoff_adapter_required(self):
  self.change('.claude/skills/handoff/SKILL.md','.agents/skills/handoff/SKILL.md','README.md'); self.assertRule('claude')
 def test_handoff_no_auto_resume(self):
  self.change('.agents/skills/handoff/SKILL.md','NO AUTO-RESUME','AUTO-RESUME'); self.assertRule('handoff')
 def test_handoff_no_new_development(self):
  self.change('.agents/skills/handoff/SKILL.md','Stop issuing new development','Allow new development'); self.assertRule('handoff')
 def test_adopt_skill_structure(self):
  (self.root/'.agents/skills/adopt-project/SKILL.md').unlink(); self.assertRule('structure')
 def test_adopt_prompt_contract(self):
  self.change('ADOPT_EXISTING_PROJECT_PROMPT.md','BEFORE modifying','AFTER modifying'); self.assertRule('adopt-prompt')
 def test_adopt_prompt_moving_branch(self):
  p=self.root/'ADOPT_EXISTING_PROJECT_PROMPT.md'
  p.write_text(re.sub(r'(agent-project-template/)[0-9a-f]{40}/',r'\1main/',p.read_text())); self.assertRule('adopt-prompt')
 def test_adopt_prompt_untrusted_review(self):
  self.change('ADOPT_EXISTING_PROJECT_PROMPT.md','explicit confirmation','go-ahead'); self.assertRule('adopt-prompt')
 def test_permissions_ask_merge(self):
  self.change('.claude/settings.json','"Bash(gh pr merge *)",',''); self.assertRule('permissions')
 def test_permissions_invalid_json(self):
  self.change('.claude/settings.json','"ask"','ask'); self.assertRule('permissions')
 def test_permissions_settings_required(self):
  (self.root/'.claude/settings.json').unlink(); self.assertRule('structure')
 def test_profile_packet_rules(self):
  self.change('.claude/agents/implementation.md','Applicable rules','policy list'); self.assertRule('claude')
 def test_packet_applicable_rules(self):
  self.change('templates/agent-work-packet.md','Applicable rules','Extra notes'); self.assertRule('dynamic-agents')
 def test_wrapper_no_restated_approvals(self):
  self.change('.claude/skills/tweak/SKILL.md','adds no rules.','adds no rules. Never treat `dale` as approval.'); self.assertRule('claude')
 def test_claude_md_no_restated_approvals(self):
  self.change('CLAUDE.md','# Claude Code adapter','# Claude Code adapter\n`ok` is not approval.'); self.assertRule('claude')
 def test_adopt_prompt_missing(self):
  (self.root/'ADOPT_EXISTING_PROJECT_PROMPT.md').unlink(); self.assertRule('structure')
 def test_adopt_skill_contract(self):
  self.change('.agents/skills/adopt-project/SKILL.md','AGENTS.md','OTHER.md'); self.assertRule('adoption')
 def test_epic_contract_required(self):
