   'Never enable auto-merge', 'creating repositories',
   'handoff workflow keeps its own prohibition',
  )
  p=self.root/'specs/methodology/approvals.md'; original=p.read_text()
  for token in cases:
   with self.subTest(token=token):
    self.assertIn(token, original)
    try:
     p.write_text(original.replace(token, 'REMOVED'))
     self.assertRule('publication')
    finally:
     p.write_text(original)
